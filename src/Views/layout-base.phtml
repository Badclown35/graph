  <span class="audio-dot" aria-hidden="true"></span><span class="audio-label">Music off</span>
</button>
<script>
(function () {
  var button = document.getElementById('graph-audio-toggle');
  if (!button) return;
  var context = null, master = null, timer = null, step = 0;
  var notes = [261.63, 329.63, 392.00, 329.63, 293.66, 349.23, 440.00, 349.23];
  function playNote() {
    if (!context || !master || context.state !== 'running') return;
    var now = context.currentTime;
    var osc = context.createOscillator();
    var gain = context.createGain();
    osc.type = 'sine';
    osc.frequency.value = notes[step % notes.length];
    gain.gain.setValueAtTime(0.0001, now);
    gain.gain.linearRampToValueAtTime(0.035, now + 0.18);
    gain.gain.exponentialRampToValueAtTime(0.0001, now + 1.05);
    osc.connect(gain); gain.connect(master);
    osc.start(now); osc.stop(now + 1.08);
    step++;
  }
  function setButton(on) {
    button.setAttribute('aria-pressed', on ? 'true' : 'false');
    button.querySelector('.audio-label').textContent = on ? 'Music on' : 'Music off';
    button.setAttribute('aria-label', on ? 'Turn background music off' : 'Turn background music on');
  }
  button.addEventListener('click', function () {
    var turningOn = button.getAttribute('aria-pressed') !== 'true';
    if (turningOn) {
      var AudioContextClass = window.AudioContext || window.webkitAudioContext;
      if (!AudioContextClass) {
        button.querySelector('.audio-label').textContent = 'Audio unavailable';
        return;
      }
      if (!context) {
        context = new AudioContextClass();
        master = context.createGain();
        master.gain.value = 0.22;
        master.connect(context.destination);
      }
      context.resume().then(function () {
        if (context.state !== 'running') return;
        setButton(true);
        playNote();
        if (timer) window.clearInterval(timer);
        timer = window.setInterval(playNote, 850);
      }).catch(function () { setButton(false); });
    } else {
      if (timer) window.clearInterval(timer);
      timer = null;
      if (context && context.state === 'running') context.suspend();
      setButton(false);
    }
  });
  // Music is intentionally off on every page load; playback requires a user tap.
  setButton(false);
})();
</script>
