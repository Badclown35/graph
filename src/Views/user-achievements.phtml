<?php
$visibleAchievements = array_filter($viewContext->achievements, function ($achievement) {
    return empty($achievement->hidden);
});
$unlockedCount = count($visibleAchievements);
$previousCount = intval($viewContext->hiddenCount);
$totalDisplayed = count($viewContext->achievements);
?>
<div class="section achi achi-dashboard">
    <div class="achi-dashboard__header">
        <div>
            <p class="achi-dashboard__eyebrow"><?php echo $viewContext->media == Media::Manga ? 'MANGA COLLECTION' : 'ANIME COLLECTION' ?></p>
            <h2>Achievements</h2>
            <p class="achi-dashboard__intro">Your milestones, collection stats, and the titles behind each achievement.</p>
        </div>
        <div class="achi-dashboard__summary-mark" aria-hidden="true">✦</div>
    </div>

    <div class="achi-dashboard__stats" aria-label="Achievement summary">
        <div class="achi-stat">
            <span class="achi-stat__value"><?php echo $unlockedCount ?></span>
            <span class="achi-stat__label">Current levels</span>
        </div>
        <div class="achi-stat">
            <span class="achi-stat__value"><?php echo $previousCount ?></span>
            <span class="achi-stat__label">Previous levels</span>
        </div>
        <div class="achi-stat">
            <span class="achi-stat__value"><?php echo $totalDisplayed ?></span>
            <span class="achi-stat__label">Levels shown</span>
        </div>
    </div>

    <?php if ($previousCount > 0): ?>
        <p class="previous-msg">You have <strong><?php echo $previousCount ?></strong> earlier achievement levels. <a href="#" class="achi-previous-toggle" aria-expanded="false">Show previous levels</a></p>
    <?php endif ?>

    <div class="achi-toolbar">
        <label class="achi-search">
            <span class="achi-search__icon" aria-hidden="true">⌕</span>
            <span class="achi-visually-hidden">Search achievements</span>
            <input type="search" class="achi-search__input" placeholder="Search achievements..." autocomplete="off">
        </label>
        <div class="achi-filters" role="group" aria-label="Filter achievements">
            <button type="button" class="achi-filter is-active" data-filter="all" aria-pressed="true">All</button>
            <button type="button" class="achi-filter" data-filter="current" aria-pressed="false">Current</button>
            <?php if ($previousCount > 0): ?>
                <button type="button" class="achi-filter" data-filter="previous" aria-pressed="false">Previous</button>
            <?php endif ?>
        </div>
    </div>

    <p class="achi-no-results" hidden>No achievements match that search.</p>

    <div class="section-body achi-grid">
        <?php if (empty($viewContext->achievements)): ?>
            <div class="achi-empty">
                <span class="achi-empty__icon" aria-hidden="true">✧</span>
                <h3>Your first achievement is waiting</h3>
                <p>No achievements yet. Keep <?php echo $viewContext->media == Media::Manga ? 'reading' : 'watching' ?> and your milestones will appear here.</p>
            </div>
        <?php else: ?>
            <?php foreach ($viewContext->achievements as $ach): ?>
                <article class="achi-entry<?php if ($ach->hidden) echo ' hidden' ?>" data-achievement-state="<?php echo $ach->hidden ? 'previous' : 'current' ?>">
                    <div class="achi-entry__top">
                        <?php if (!empty($ach->path)): ?>
                            <img class="achi<?php if (!empty($ach->entries)): ?> entries-trigger<?php endif ?>" alt="<?php echo htmlspecialchars($ach->title, ENT_QUOTES, 'UTF-8') ?>" src="<?php echo '/image/achievement/' . rawurlencode($ach->path); ?>">
                        <?php endif ?>
                        <?php if (!empty($ach->level)): ?>
                            <span class="achi-entry__level"><?php echo htmlspecialchars($ach->level, ENT_QUOTES, 'UTF-8') ?></span>
                        <?php endif ?>
                        <h3><?php echo htmlspecialchars($ach->title, ENT_QUOTES, 'UTF-8') ?></h3>
                    </div>

                    <?php if (isset($ach->progress)): ?>
                        <?php
                        $progress = max(0, min(100, floatval($ach->progress)));
                        $progressLabel = isset($ach->subject) ? 'Progress: ' . $ach->subject : 'Achievement progress';
                        ?>
                        <div class="progress-wrapper" role="progressbar" aria-label="<?php echo htmlspecialchars($progressLabel, ENT_QUOTES, 'UTF-8') ?>" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<?php echo round($progress) ?>">
                            <div class="progress">
                                <div class="bar" style="width: <?php echo $progress ?>%"></div>
                            </div>
                        </div>
                    <?php endif ?>

                    <?php if (!empty($ach->desc)): ?>
                        <p class="desc"><?php echo htmlspecialchars($ach->desc, ENT_QUOTES, 'UTF-8') ?></p>
                    <?php endif ?>

                    <?php if (!empty($ach->entries)): ?>
                        <div class="achi-entry__actions">
                            <button type="button" class="entries-trigger-button">View qualifying titles <span aria-hidden="true">→</span></button>
                        </div>
                        <div class="entries-wrapper singular">
                            <p>
                                <a class="close" href="#" aria-label="Close qualifying titles"><i class="icon-close"></i></a>
                                <?php if ($viewContext->private): ?>
                                    Titles from this private list can&rsquo;t be shown.
                                <?php else: ?>
                                    Awarded for <?php echo $viewContext->media == Media::Manga ? 'reading' : 'watching' ?> these (<?php echo count($ach->entries) ?>):
                                <?php endif ?>
                            </p>
                            <?php if (!$viewContext->private): ?>
                                <ul>
                                    <?php foreach ($ach->entries as $e): ?>
                                        <li><a target="_blank" rel="noopener noreferrer" href="<?php echo htmlspecialchars($e->mal_link, ENT_QUOTES, 'UTF-8') ?>"><?php echo htmlspecialchars($e->title, ENT_QUOTES, 'UTF-8') ?></a></li>
                                    <?php endforeach ?>
                                </ul>
                            <?php endif ?>
                        </div>
                    <?php endif ?>
                </article>
            <?php endforeach ?>
        <?php endif ?>
    </div>
</div>
